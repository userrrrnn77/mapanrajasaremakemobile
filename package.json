{
  "name": "mapan-rajasa-remake-react_native",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "bun run taskset & bun run android",
    "taskset": "taskset -c 3 scrcpy --turn-screen-off --always-on-top --max-fps 30",
    "start": "systemd-run --user --scope -p CPUQuota=40% -p MemoryMax=3G taskset -c 0-2 bun expo start --offline",
    "android": "systemd-run --user --scope -p CPUQuota=40% -p MemoryMax=3G taskset -c 0-2 bun expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@tanstack/react-query": "^5.100.8",
    "@types/jest": "29.5.14",
    "@types/mocha": "^10.0.10",
    "axios": "^1.15.2",
    "expo": "~52.0.0",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-face-detector": "~13.0.2",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.12"
  },
  "resolutions": {
    "react-native-reanimated": "~3.16.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
